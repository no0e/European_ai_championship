# Task 2 (model equality testing) - the only file to edit before running.
# Working directory: collected answers, intermediate files and outputs are written here.
export T2_WORK=${T2_WORK:-$HOME/t2_work}
# Hugging Face checkpoints for the white-box steps (07-08). A folder <org>--<name> per model, e.g.
# Qwen--Qwen2.5-1.5B-Instruct; when a folder is missing, the model is downloaded from the Hugging Face Hub.
export T2_MODELS=${T2_MODELS:-$HOME/hf_models}
# GPU used by the white-box scoring (step 07); CPU works but is slow.
export T2_GPU=${T2_GPU:-0}
# Team key for the task server (only for the paid collection steps 02/05 and for submitting). Never printed.
# export API_KEY=...
export MET_API_KEY=${MET_API_KEY:-${API_KEY:-}}
# 1 = re-run the paid collections (steps 02 and 05) instead of using the answers shipped in data/.
export COLLECT=${COLLECT:-0}
# Python interpreter (e.g. python3, or the python of a virtual environment).
export PY=${PY:-python}
