# Task 3 (unlearning) - the only file to edit before running.
# Working directory: must contain the official task files model.pt and forget_images.npz.
# All intermediate files (anchors, variants, targets, models, logs) are written here.
export T3_WORK=${T3_WORK:-$HOME/t3_work}
# Folder of COCO val2017 images (*.jpg), used as anchor images (step 01).
export COCO_DIR=${COCO_DIR:-$HOME/data/coco/val2017}
# GPUs used in parallel by step 03 (one model per GPU at a time).
export GPUS=${GPUS:-"0 1 2 3"}
# fp16 for GPUs without native bf16 (default: bf16).
# export K3_AMP=fp16
# Submission (step 05 only). The key is never printed.
export T3_SUBMIT_URL=${T3_SUBMIT_URL:-http://34.147.229.55/submit/31-unlearning}
# export T3_API_KEY=...
# Python interpreter (e.g. python3, or the python of a virtual environment).
export PY=${PY:-python}
