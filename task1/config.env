# Task 1 (watermark localisation) - the only file to edit before running.
# Data: $T1_DATA/release/{train,test}/ (official zips unpacked), $T1_DATA/clean/DIV2K_valid_HR/ (DIV2K validation HR).
export T1_DATA=${T1_DATA:-$HOME/t1_data}
# Official watermark models, written by step 00 (src/starter_kit/download_models.py).
export T1_MODELS=${T1_MODELS:-$T1_DATA/models}
# Outputs: pairs*/, runs/, mix/, cache/, out/ (submission files), logs/. Several hundred GB with all pair sets.
export T1_WORK=${T1_WORK:-$HOME/t1_work}
# ImageNet weights of timm convnext_tiny (backbone of the StegaStamp detector), a .safetensors file.
export CONVNEXT_WEIGHTS=${CONVNEXT_WEIGHTS:-$T1_DATA/weights/convnext_tiny.safetensors}
# SAM ViT-H checkpoint (sam_vit_h_4b8939.pth) and the segment_anything package (step 03).
export SAM_WEIGHTS=${SAM_WEIGHTS:-$T1_DATA/weights/sam_vit_h_4b8939.pth}
# GPUs used in parallel (the hackathon runs used one node with 4 x A100 40 GB).
export GPUS=${GPUS:-"0 1 2 3"}
export WORKERS=${WORKERS:-20}           # data-loader workers per training process
# Training budgets in minutes (the trainers measure their cost per step and fit the step count to the budget).
export LONG_BUDGET_MIN=${LONG_BUDGET_MIN:-81}   # step 07, second-scale long training (the hackathon value, read from the job log)
export K5B_BUDGET_MIN=${K5B_BUDGET_MIN:-18}     # step 10, frame bases PixelSeal / TrustMark
export K5B_SS_BUDGET_MIN=${K5B_SS_BUDGET_MIN:-14}
export K6B_BUDGET_MIN=${K6B_BUDGET_MIN:-13}
# Python interpreter.
export PY=${PY:-python}
# Submission (step 13 only). The key is never printed.
# export WMLOC_API_KEY=...
